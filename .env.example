# =============================================================================
# FORGE INDIA CONNECT (FIC) - ENVIRONMENT TEMPLATE (.env.example)
# =============================================================================
# Copy this file to .env and fill in the required values.
# NEVER commit your actual .env file with secrets into version control.
# =============================================================================

# 1. CORE APPLICATION & RUNTIME ENVIRONMENT
NODE_ENV=development
PORT=3000
APP_NAME=FIC_Territory_Operations_Manager
APP_VERSION=1.0.0
APP_PUBLIC_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api/v1
SOCKET_URL=http://localhost:3000
LOG_LEVEL=info

# 2. AUTHENTICATION & JWT SECRETS
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_here
OTP_SALT_SECRET=your_otp_salt_secret_here
API_ENCRYPTION_KEY=your_aes256_encryption_key_here
SESSION_SECRET=your_session_secret_key_here

# 3. DATABASE (MongoDB Atlas / PostgreSQL)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/fic_operations?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://<username>:<password>@fic-cluster.mongodb.net/fic_operations?retryWrites=true&w=majority
DB_NAME=fic_operations
DB_SSL=true

# 4. REDIS / CACHE
REDIS_URL=redis://default:<password>@<host>:6379

# 5. CLOUD STORAGE (AWS S3)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=fic-operations-storage

# 6. CLOUDINARY
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 7. SMS & OTP GATEWAY
FAST2SMS_API_KEY=your_fast2sms_api_key
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# 8. MAPS & LOCATION
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# 9. PUSH NOTIFICATIONS (Firebase)
FIREBASE_PROJECT_ID=fic-connect-app
FCM_SERVER_KEY=your_fcm_server_key

# 10. MONITORING & LOGGING
SENTRY_DSN=https://your_sentry_key@sentry.io/project
ENABLE_AUDIT_LOG_STREAMING=true
