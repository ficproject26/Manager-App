\u0bc1',action_edit_profile:'\u0b9a\u0bc1\u0baf\u0bb5\u0bbf\u0bb5\u0bb0\u0ba4\u0bcd\u0ba4\u0bc8\u0ba4\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1',action_delete:'\u0ba8\u0bc0\u0b95\u0bcd\u0b95\u0bc1',action_logout:'\u0bb5\u0bc6\u0bb3\u0bbf\u0baf\u0bc7\u0bb1\u0bc1',action_retry:'\u0bae\u0bc0\u0ba3\u0bcd\u0b9f\u0bc1\u0bae\u0bcd \u0bae\u0bc1\u0baf\u0bb1\u0bcd\u0b9a\u0bbf',action_back:'\u0baa\u0bbf\u0ba9\u0bcd\u0b9a\u0bc6\u0bb2\u0bcd',action_confirm:'\u0b89\u0bb1\u0bc1\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1',action_close:'\u0bae\u0bc2\u0b9f\u0bc1',action_start:'\u0ba4\u0bca\u0b9f\u0b99\u0bcd\u0b95\u0bc1',action_complete:'\u0bae\u0bc1\u0b9f\u0bbf\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd',action_accept:'\u0b8f\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0b95\u0bca\u0bb3\u0bcd',action_reject:'\u0ba8\u0bbf\u0bb0\u0bbe\u0b95\u0bb0\u0bbf',action_saving:'\u0b9a\u0bc7\u0bae\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1...',action_logging_out:'\u0bb5\u0bc6\u0bb3\u0bbf\u0baf\u0bc7\u0bb1\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1...',header_profile:'\u0bae\u0bc7\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0b9a\u0bc1\u0baf\u0bb5\u0bbf\u0bb5\u0bb0\u0bae\u0bcd',header_settings:'\u0b85\u0bae\u0bc8\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bcd',header_notifications:'\u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bcd',header_tasks:'\u0baa\u0ba3\u0bbf\u0b95\u0bb3\u0bcd \u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0baf\u0bb2\u0bcd',header_vendors:'\u0bb5\u0ba3\u0bbf\u0b95\u0bb0\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0b9f\u0bcd\u0b9f\u0bbf\u0baf\u0bb2\u0bcd',header_reports:'\u0ba4\u0bbf\u0ba9\u0b9a\u0bb0\u0bbf \u0b85\u0bb1\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0b95\u0bb3\u0bcd',header_dashboard:'\u0b9f\u0bbe\u0bb7\u0bcd\u0baa\u0bcb\u0bb0\u0bcd\u0b9f\u0bc1',section_account_info:'\u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bc1 \u0ba4\u0b95\u0bb5\u0bb2\u0bcd',section_work_scope:'\u0baa\u0ba3\u0bbf \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b8e\u0bb2\u0bcd\u0bb2\u0bc8 \u0bb5\u0bb0\u0bae\u0bcd\u0baa\u0bc1',section_identity_kyc:'\u0b85\u0b9f\u0bc8\u0baf\u0bbe\u0bb3\u0bae\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0bb0\u0bbf\u0baa\u0bbe\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bc1 (KYC)',section_bank_details:'\u0bb5\u0b99\u0bcd\u0b95\u0bbf \u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bbf\u0bb5\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd',section_actions:'\u0bb5\u0bbf\u0bb0\u0bc8\u0bb5\u0bc1 \u0ba8\u0b9f\u0bb5\u0b9f\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0b95\u0bb3\u0bcd',field_full_name:'\u0bae\u0bc1\u0bb4\u0bc1 \u0baa\u0bc6\u0baf\u0bb0\u0bcd',field_email:'\u0b85\u0bb2\u0bc1\u0bb5\u0bb2\u0b95 \u0bae\u0bbf\u0ba9\u0bcd\u0ba9\u0b9e\u0bcd\u0b9a\u0bb2\u0bcd',field_mobile:'\u0baa\u0ba4\u0bbf\u0bb5\u0bc1\u0b9a\u0bc6\u0baf\u0bcd\u0ba4 \u0bae\u0bca\u0baa\u0bc8\u0bb2\u0bcd',field_dob:'\u0baa\u0bbf\u0bb1\u0ba8\u0bcd\u0ba4 \u0ba4\u0bc7\u0ba4\u0bbf',field_gender:'\u0baa\u0bbe\u0bb2\u0bbf\u0ba9\u0bae\u0bcd',field_employee_id:'\u0bae\u0bc7\u0bb2\u0bbe\u0bb3\u0bb0\u0bcd \u0b90\u0b9f\u0bbf (Employee ID)',field_role:'\u0b92\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0baa\u0ba4\u0bb5\u0bbf',field_role_level:'\u0baa\u0ba4\u0bb5\u0bbf \u0ba8\u0bbf\u0bb2\u0bc8',field_territory:'\u0b92\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b8e\u0bb2\u0bcd\u0bb2\u0bc8',field_supervisor:'\u0ba8\u0bc7\u0bb0\u0b9f\u0bbf \u0bae\u0bc7\u0bb1\u0bcd\u0baa\u0bbe\u0bb0\u0bcd\u0bb5\u0bc8\u0baf\u0bbe\u0bb3\u0bb0\u0bcd',field_status:'\u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bc1 \u0ba8\u0bbf\u0bb2\u0bc8',field_active_since:'\u0b9a\u0bc6\u0baf\u0bb2\u0bbf\u0bb2\u0bcd \u0b89\u0bb3\u0bcd\u0bb3 \u0ba8\u0bbe\u0bb3\u0bcd',field_aadhaar:'\u0b86\u0ba4\u0bbe\u0bb0\u0bcd \u0b8e\u0ba3\u0bcd',field_pan:'\u0baa\u0bbe\u0ba9\u0bcd \u0b8e\u0ba3\u0bcd',field_residential_address:'\u0bae\u0bc1\u0b95\u0bb5\u0bb0\u0bbf',field_account_holder:'\u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bc1 \u0bb5\u0bc8\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0bb5\u0bb0\u0bcd \u0baa\u0bc6\u0baf\u0bb0\u0bcd',field_bank_name:'\u0bb5\u0b99\u0bcd\u0b95\u0bbf \u0baa\u0bc6\u0baf\u0bb0\u0bcd',field_branch:'\u0b95\u0bbf\u0bb3\u0bc8 \u0baa\u0bc6\u0baf\u0bb0\u0bcd',field_account_number:'\u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bc1 \u0b8e\u0ba3\u0bcd',field_ifsc:'IFSC \u0b95\u0bc1\u0bb1\u0bbf\u0baf\u0bc0\u0b9f\u0bc1',field_city:'\u0ba8\u0b95\u0bb0\u0bae\u0bcd',field_street:'\u0ba4\u0bc6\u0bb0\u0bc1 / \u0b95\u0ba4\u0bb5\u0bc1 \u0b8e\u0ba3\u0bcd',field_pincode:'\u0baa\u0bbf\u0ba9\u0bcd\u0b95\u0bcb\u0b9f\u0bcd',priority_high:'\u0b89\u0baf\u0bb0\u0bcd \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0bc1\u0bb0\u0bbf\u0bae\u0bc8 (HIGH)',priority_medium:'\u0ba8\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bb0 \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0bc1\u0bb0\u0bbf\u0bae\u0bc8 (MEDIUM)',priority_low:'\u0b95\u0bc1\u0bb1\u0bc8\u0ba8\u0bcd\u0ba4 \u0bae\u0bc1\u0ba9\u0bcd\u0ba9\u0bc1\u0bb0\u0bbf\u0bae\u0bc8 (LOW)',filter_all:'\u0b85\u0ba9\u0bc8\u0ba4\u0bcd\u0ba4\u0bc1\u0bae\u0bcd',status_active:'\u0b9a\u0bc6\u0baf\u0bb2\u0bbf\u0bb2\u0bcd & \u0b85\u0b99\u0bcd\u0b95\u0bc0\u0b95\u0bb0\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1',status_under_review:'\u0bae\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0bbe\u0baf\u0bcd\u0bb5\u0bbf\u0bb2\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1',status_pending:'\u0ba8\u0bbf\u0bb2\u0bc1\u0bb5\u0bc8\u0baf\u0bbf\u0bb2\u0bcd',status_assigned:'\u0b92\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1',status_accepted:'\u0b8f\u0bb1\u0bcd\u0bb1\u0bc1\u0b95\u0bcd\u0b95\u0bca\u0bb3\u0bcd\u0bb3\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1',status_in_progress:'\u0b9a\u0bc6\u0baf\u0bb2\u0bbf\u0bb2\u0bcd \u0b89\u0bb3\u0bcd\u0bb3\u0ba4\u0bc1',status_completed:'\u0bae\u0bc1\u0b9f\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1',status_blocked:'\u0ba4\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1',status_resolved:'\u0ba4\u0bc0\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1',settings_subtitle:'\u0baa\u0baf\u0ba9\u0bcd\u0baa\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1 \u0bb5\u0bbf\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0b99\u0bcd\u0b95\u0bb3\u0bc8 \u0ba8\u0bbf\u0bb0\u0bcd\u0bb5\u0b95\u0bbf\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd',settings_notifications:'\u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bcd',settings_notification_prefs:'\u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0baa\u0bcd\u0baa\u0bc1 \u0bb5\u0bbf\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0b99\u0bcd\u0b95\u0bb3\u0bcd',settings_app:'\u0baa\u0baf\u0ba9\u0bcd\u0baa\u0bbe\u0b9f\u0bc1',settings_language:'\u0bae\u0bca\u0bb4\u0bbf (Language)',settings_about:'FIC \u0baa\u0bb1\u0bcd\u0bb1\u0bbf',settings_account:'\u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bc1',settings_push_title:'\u0baa\u0bc1\u0bb7\u0bcd \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bcd',settings_push_desc:'\u0baa\u0ba3\u0bbf\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0bc1\u0ba4\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bbe\u0ba9 \u0b8e\u0b9a\u0bcd\u0b9a\u0bb0\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0b95\u0bb3\u0bc8\u0baa\u0bcd \u0baa\u0bc6\u0bb1\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd',settings_email_title:'\u0bae\u0bbf\u0ba9\u0bcd\u0ba9\u0b9e\u0bcd\u0b9a\u0bb2\u0bcd \u0b9a\u0bc1\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bae\u0bcd',settings_email_desc:'\u0ba4\u0bbf\u0ba9\u0b9a\u0bb0\u0bbf \u0b95\u0bb3 \u0b85\u0bb1\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0b9a\u0bcd \u0b9a\u0bc1\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0ba4\u0bcd\u0ba4\u0bc8\u0baa\u0bcd \u0baa\u0bc6\u0bb1\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd',settings_kyc_title:'KYC \u0b8e\u0b9a\u0bcd\u0b9a\u0bb0\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0b95\u0bb3\u0bcd',settings_kyc_desc:'\u0bb5\u0ba3\u0bbf\u0b95\u0bb0\u0bcd \u0b9a\u0bb0\u0bbf\u0baa\u0bbe\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bc1 \u0baa\u0bc1\u0ba4\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bc8\u0baa\u0bcd \u0baa\u0bc6\u0bb1\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd',settings_status_alerts:'\u0ba8\u0bbf\u0bb2\u0bc8 \u0bae\u0bbe\u0bb1\u0bcd\u0bb1 \u0b8e\u0b9a\u0bcd\u0b9a\u0bb0\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0b95\u0bb3\u0bcd',settings_status_alerts_desc:'\u0baa\u0ba3\u0bbf \u0ba8\u0bbf\u0bb2\u0bc8 \u0bae\u0bbe\u0bb1\u0bc1\u0bae\u0bcd\u0baa\u0bcb\u0ba4\u0bc1 \u0b8e\u0b9a\u0bcd\u0b9a\u0bb0\u0bbf\u0b95\u0bcd\u0b95\u0bc8 \u0baa\u0bc6\u0bb1\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd',modal_logout_title:'\u0bb5\u0bc6\u0bb3\u0bbf\u0baf\u0bc7\u0bb1\u0bc1\u0bb5\u0ba4\u0bc8 \u0b89\u0bb1\u0bc1\u0ba4\u0bbf\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1',modal_logout_msg:'\u0ba8\u0bbf\u0b9a\u0bcd\u0b9a\u0baf\u0bae\u0bbe\u0b95 \u0bb5\u0bc6\u0bb3\u0bbf\u0baf\u0bc7\u0bb1 \u0bb5\u0bbf\u0bb0\u0bc1\u0bae\u0bcd\u0baa\u0bc1\u0b95\u0bbf\u0bb1\u0bc0\u0bb0\u0bcd\u0b95\u0bb3\u0bbe?',modal_edit_profile_title:'\u0b9a\u0bc1\u0baf\u0bb5\u0bbf\u0bb5\u0bb0\u0ba4\u0bcd\u0ba4\u0bc8\u0ba4\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1',modal_edit_bank_title:'\u0bb5\u0b99\u0bcd\u0b95\u0bbf \u0bb5\u0bbf\u0bb5\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bc8\u0ba4\u0bcd \u0ba4\u0bbf\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1',modal_language_title:'\u0bae\u0bca\u0bb4\u0bbf\u0baf\u0bc8\u0ba4\u0bcd \u0ba4\u0bc7\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd',msg_saved_success:'\u0bb5\u0bbf\u0bb5\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bb5\u0bc6\u0bb1\u0bcd\u0bb1\u0bbf\u0b95\u0bb0\u0bae\u0bbe\u0b95 \u0b9a\u0bc7\u0bae\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba9!',msg_update_error:'\u0baa\u0bc1\u0ba4\u0bc1\u0baa\u0bcd\u0baa\u0bbf\u0b95\u0bcd\u0b95 \u0bae\u0bc1\u0b9f\u0bbf\u0baf\u0bb5\u0bbf\u0bb2\u0bcd\u0bb2\u0bc8. \u0bb5\u0bbf\u0bb5\u0bb0\u0b99\u0bcd\u0b95\u0bb3\u0bc8\u0b9a\u0bcd \u0b9a\u0bb0\u0bbf\u0baa\u0bbe\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd.',msg_loading_profile:'\u0b9a\u0bc1\u0baf\u0bb5\u0bbf\u0bb5\u0bb0\u0bae\u0bcd \u0b8f\u0bb1\u0bcd\u0bb1\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1...',msg_empty_tasks:'\u0ba4\u0bb1\u0bcd\u0baa\u0bcb\u0ba4\u0bc1 \u0baa\u0ba3\u0bbf\u0b95\u0bb3\u0bcd \u0b8e\u0ba4\u0bc1\u0bb5\u0bc1\u0bae\u0bcd \u0b92\u0ba4\u0bc1\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bb5\u0bbf\u0bb2\u0bcd\u0bb2\u0bc8.',msg_empty_notifications:'\u0ba4\u0bb1\u0bcd\u0baa\u0bcb\u0ba4\u0bc1 \u0baa\u0bc1\u0ba4\u0bbf\u0baf \u0b85\u0bb1\u0bbf\u0bb5\u0bbf\u0baa\u0bcd\u0baa\u0bc1\u0b95\u0bb3\u0bcd \u0b87\u0bb2\u0bcd\u0bb2\u0bc8.'},te:{nav_home:'\u0c39\u0c4b\u0c2e\u0c4d',nav_tasks:'\u0c2a\u0c28\u0c41\u0c32\u0c41 (Tasks)',nav_vendors:'\u0c35\u0c4d\u0c2f\u0c3e\u0c2a\u0c3e\u0c30\u0c41\u0c32\u0c41',nav_reports:'\u0c28\u0c3f\u0c35\u0c47\u0c26\u0c3f\u0c15\u0c32\u0c41',nav_profile:'\u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d',nav_more:'\u0c2e\u0c30\u0c3f\u0c28\u0c4d\u0c28\u0c3f',action_save:'\u0c2d\u0c26\u0c4d\u0c30\u0c2a\u0c30\u0c1a\u0c41',action_cancel:'\u0c30\u0c26\u0c4d\u0c26\u0c41 \u0c1a\u0c47\u0c2f\u0c3f',action_done:'\u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c2f\u0c3f\u0c02\u0c26\u0c3f',action_edit:'\u0c38\u0c35\u0c30\u0c3f\u0c02\u0c1a\u0c41',action_edit_profile:'\u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d \u0c38\u0c35\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f',action_delete:'\u0c24\u0c4a\u0c32\u0c17\u0c3f\u0c02\u0c1a\u0c41',action_logout:'\u0c32\u0c3e\u0c17\u0c4d \u0c05\u0c35\u0c41\u0c1f\u0c4d',action_retry:'\u0c2e\u0c33\u0c4d\u0c32\u0c40 \u0c2a\u0c4d\u0c30\u0c2f\u0c24\u0c4d\u0c28\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f',action_back:'\u0c35\u0c46\u0c28\u0c41\u0c15\u0c15\u0c41',action_confirm:'\u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c41',action_close:'\u0c2e\u0c42\u0c38\u0c3f\u0c35\u0c47\u0c2f\u0c3f',action_start:'\u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d\u0c3f\u0c02\u0c1a\u0c41',action_complete:'\u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c1a\u0c47\u0c2f\u0c3f',action_accept:'\u0c38\u0c4d\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c41',action_reject:'\u0c24\u0c3f\u0c30\u0c38\u0c4d\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c41',action_saving:'\u0c2d\u0c26\u0c4d\u0c30\u0c2a\u0c30\u0c41\u0c38\u0c4d\u0c24\u0c4b\u0c02\u0c26\u0c3f...',action_logging_out:'\u0c32\u0c3e\u0c17\u0c4d \u0c05\u0c35\u0c41\u0c1f\u0c4d \u0c05\u0c35\u0c41\u0c24\u0c4b\u0c02\u0c26\u0c3f...',header_profile:'\u0c2e\u0c47\u0c28\u0c47\u0c1c\u0c30\u0c4d \u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d',header_settings:'\u0c38\u0c46\u0c1f\u0c4d\u0c1f\u0c3f\u0c02\u0c17\u0c4d\u200c\u0c32\u0c41',header_notifications:'\u0c28\u0c4b\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d\u200c\u0c32\u0c41',header_tasks:'\u0c2a\u0c28\u0c41\u0c32 \u0c1c\u0c3e\u0c2c\u0c3f\u0c24\u0c3e',header_vendors:'\u0c35\u0c4d\u0c2f\u0c3e\u0c2a\u0c3e\u0c30\u0c41\u0c32 \u0c1c\u0c3e\u0c2c\u0c3f\u0c24\u0c3e',header_reports:'\u0c28\u0c3f\u0c35\u0c47\u0c26\u0c3f\u0c15\u0c32\u0c41',header_dashboard:'\u0c21\u0c4d\u0c2f\u0c3e\u0c37\u0c4d\u200c\u0c2c\u0c4b\u0c30\u0c4d\u0c21\u0c4d',section_account_info:'\u0c16\u0c3e\u0c24\u0c3e \u0c38\u0c2e\u0c3e\u0c1a\u0c3e\u0c30\u0c02',section_work_scope:'\u0c2a\u0c28\u0c3f \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c2a\u0c30\u0c3f\u0c27\u0c3f \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41',section_identity_kyc:'\u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c23 (KYC)',section_bank_details:'\u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c4d \u0c16\u0c3e\u0c24\u0c3e \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41',section_actions:'\u0c24\u0c4d\u0c35\u0c30\u0c3f\u0c24 \u0c1a\u0c30\u0c4d\u0c2f\u0c32\u0c41',field_full_name:'\u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c2a\u0c47\u0c30\u0c41',field_email:'\u0c05\u0c27\u0c3f\u0c15\u0c3e\u0c30\u0c3f\u0c15 \u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d',field_mobile:'\u0c28\u0c2e\u0c4b\u0c26\u0c3f\u0c24 \u0c2e\u0c4a\u0c2c\u0c48\u0c32\u0c4d',field_dob:'\u0c2a\u0c41\u0c1f\u0c4d\u0c1f\u0c3f\u0c28 \u0c24\u0c47\u0c26\u0c40',field_gender:'\u0c32\u0c3f\u0c02\u0c17\u0c02',field_employee_id:'\u0c2e\u0c47\u0c28\u0c47\u0c1c\u0c30\u0c4d \u0c10\u0c21\u0c3f (Employee ID)',field_role:'\u0c15\u0c47\u0c1f\u0c3e\u0c2f\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c2a\u0c3e\u0c24\u0c4d\u0c30',field_role_level:'\u0c2a\u0c3e\u0c24\u0c4d\u0c30 \u0c38\u0c4d\u0c25\u0c3e\u0c2f\u0c3f',field_territory:'\u0c15\u0c47\u0c1f\u0c3e\u0c2f\u0c3f\u0c02\u0c1a\u0c3f\u0c28 \u0c2a\u0c30\u0c3f\u0c27\u0c3f',field_supervisor:'\u0c2a\u0c4d\u0c30\u0c24\u0c4d\u0c2f\u0c15\u0c4d\u0c37 \u0c2a\u0c30\u0c4d\u0c2f\u0c35\u0c47\u0c15\u0c4d\u0c37\u0c15\u0c41\u0c21\u0c41',field_status:'\u0c16\u0c3e\u0c24\u0c3e \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f',field_active_since:'\u0c2f\u0c3e\u0c15\u0c4d\u0c1f\u0c3f\u0c35\u0c4d \u0c24\u0c47\u0c26\u0c40',field_aadhaar:'\u0c06\u0c27\u0c3e\u0c30\u0c4d \u0c38\u0c02\u0c16\u0c4d\u0c2f',field_pan:'\u0c2a\u0c3e\u0c28\u0c4d \u0c38\u0c02\u0c16\u0c4d\u0c2f',field_residential_address:'\u0c1a\u0c3f\u0c30\u0c41\u0c28\u0c3e\u0c2e\u0c3e',field_account_holder:'\u0c16\u0c3e\u0c24\u0c3e\u0c26\u0c3e\u0c30\u0c41\u0c28\u0c3f \u0c2a\u0c47\u0c30\u0c41',field_bank_name:'\u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c4d \u0c2a\u0c47\u0c30\u0c41',field_branch:'\u0c36\u0c3e\u0c16 \u0c2a\u0c47\u0c30\u0c41',field_account_number:'\u0c16\u0c3e\u0c24\u0c3e \u0c38\u0c02\u0c16\u0c4d\u0c2f',field_ifsc:'IFSC \u0c15\u0c4b\u0c21\u0c4d',field_city:'\u0c28\u0c17\u0c30\u0c02',field_street:'\u0c35\u0c40\u0c27\u0c3f / \u0c07\u0c02\u0c1f\u0c3f \u0c28\u0c02\u0c2c\u0c30\u0c4d',field_pincode:'\u0c2a\u0c3f\u0c28\u0c4d\u200c\u0c15\u0c4b\u0c21\u0c4d',priority_high:'\u0c05\u0c27\u0c3f\u0c15 \u0c2a\u0c4d\u0c30\u0c3e\u0c27\u0c3e\u0c28\u0c4d\u0c2f\u0c24 (HIGH)',priority_medium:'\u0c2e\u0c27\u0c4d\u0c2f\u0c38\u0c4d\u0c25 \u0c2a\u0c4d\u0c30\u0c3e\u0c27\u0c3e\u0c28\u0c4d\u0c2f\u0c24 (MEDIUM)',priority_low:'\u0c24\u0c15\u0c4d\u0c15\u0c41\u0c35 \u0c2a\u0c4d\u0c30\u0c3e\u0c27\u0c3e\u0c28\u0c4d\u0c2f\u0c24 (LOW)',filter_all:'\u0c05\u0c28\u0c4d\u0c28\u0c40',status_active:'\u0c2f\u0c3e\u0c15\u0c4d\u0c1f\u0c3f\u0c35\u0c4d & \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f',status_under_review:'\u0c38\u0c2e\u0c40\u0c15\u0c4d\u0c37\u0c32\u0c4b \u0c09\u0c02\u0c26\u0c3f',status_pending:'\u0c2a\u0c46\u0c02\u0c21\u0c3f\u0c02\u0c17\u0c4d\u200c\u0c32\u0c4b \u0c09\u0c02\u0c26\u0c3f',status_assigned:'\u0c15\u0c47\u0c1f\u0c3e\u0c2f\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f',status_accepted:'\u0c38\u0c4d\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f',status_in_progress:'\u0c2a\u0c41\u0c30\u0c4b\u0c17\u0c24\u0c3f\u0c32\u0c4b \u0c09\u0c02\u0c26\u0c3f',status_completed:'\u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c2f\u0c3f\u0c02\u0c26\u0c3f',status_blocked:'\u0c28\u0c3f\u0c30\u0c4b\u0c27\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f',status_resolved:'\u0c2a\u0c30\u0c3f\u0c37\u0c4d\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f',settings_subtitle:'\u0c2f\u0c3e\u0c2a\u0c4d \u0c2a\u0c4d\u0c30\u0c3e\u0c27\u0c3e\u0c28\u0c4d\u0c2f\u0c24\u0c32\u0c28\u0c41 \u0c28\u0c3f\u0c30\u0c4d\u0c35\u0c39\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f',settings_notifications:'\u0c28\u0c4b\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d\u200c\u0c32\u0c41',settings_notification_prefs:'\u0c28\u0c4b\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d \u0c2a\u0c4d\u0c30\u0c3e\u0c27\u0c3e\u0c28\u0c4d\u0c2f\u0c24\u0c32\u0c41',settings_app:'\u0c05\u0c2a\u0c4d\u0c32\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d',settings_language:'\u0c2d\u0c3e\u0c37 (Language)',settings_about:'FIC \u0c17\u0c41\u0c30\u0c3f\u0c02\u0c1a\u0c3f',settings_account:'\u0c16\u0c3e\u0c24\u0c3e',settings_push_title:'\u0c2a\u0c41\u0c37\u0c4d \u0c28\u0c4b\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d\u200c\u0c32\u0c41',settings_push_desc:'\u0c2a\u0c28\u0c41\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d\u200c\u0c32 \u0c39\u0c46\u0c1a\u0c4d\u0c1a\u0c30\u0c3f\u0c15\u0c32\u0c28\u0c41 \u0c2a\u0c4a\u0c02\u0c26\u0c02\u0c21\u0c3f',settings_email_title:'\u0c07\u0c2e\u0c46\u0c2f\u0c3f\u0c32\u0c4d \u0c38\u0c3e\u0c30\u0c3e\u0c02\u0c36\u0c02',settings_email_desc:'\u0c30\u0c4b\u0c1c\u0c41\u0c35\u0c3e\u0c30\u0c40 \u0c28\u0c3f\u0c35\u0c47\u0c26\u0c3f\u0c15\u0c32 \u0c38\u0c3e\u0c30\u0c3e\u0c02\u0c36\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c2a\u0c4a\u0c02\u0c26\u0c02\u0c21\u0c3f',settings_kyc_title:'KYC \u0c39\u0c46\u0c1a\u0c4d\u0c1a\u0c30\u0c3f\u0c15\u0c32\u0c41',settings_kyc_desc:'\u0c35\u0c4d\u0c2f\u0c3e\u0c2a\u0c3e\u0c30\u0c3f \u0c27\u0c43\u0c35\u0c40\u0c15\u0c30\u0c23 \u0c05\u0c2a\u0c4d\u200c\u0c21\u0c47\u0c1f\u0c4d\u200c\u0c32\u0c28\u0c41 \u0c2a\u0c4a\u0c02\u0c26\u0c02\u0c21\u0c3f',settings_status_alerts:'\u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f \u0c2e\u0c3e\u0c30\u0c4d\u0c2a\u0c41 \u0c39\u0c46\u0c1a\u0c4d\u0c1a\u0c30\u0c3f\u0c15\u0c32\u0c41',settings_status_alerts_desc:'\u0c2a\u0c28\u0c3f \u0c38\u0c4d\u0c25\u0c3f\u0c24\u0c3f \u0c2e\u0c3e\u0c30\u0c3f\u0c28\u0c2a\u0c4d\u0c2a\u0c41\u0c21\u0c41 \u0c35\u0c46\u0c02\u0c1f\u0c28\u0c47 \u0c24\u0c46\u0c32\u0c41\u0c38\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f',modal_logout_title:'\u0c32\u0c3e\u0c17\u0c4d \u0c05\u0c35\u0c41\u0c1f\u0c4d \u0c28\u0c3f\u0c30\u0c4d\u0c27\u0c3e\u0c30\u0c23',modal_logout_msg:'\u0c2e\u0c40\u0c30\u0c41 \u0c16\u0c1a\u0c4d\u0c1a\u0c3f\u0c24\u0c02\u0c17\u0c3e \u0c32\u0c3e\u0c17\u0c4d \u0c05\u0c35\u0c41\u0c1f\u0c4d \u0c1a\u0c47\u0c2f\u0c3e\u0c32\u0c28\u0c41\u0c15\u0c41\u0c02\u0c1f\u0c41\u0c28\u0c4d\u0c28\u0c3e\u0c30\u0c3e?',modal_edit_profile_title:'\u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41 \u0c38\u0c35\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f',modal_edit_bank_title:'\u0c2c\u0c4d\u0c2f\u0c3e\u0c02\u0c15\u0c4d \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41 \u0c38\u0c35\u0c30\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f',modal_language_title:'\u0c2d\u0c3e\u0c37\u0c28\u0c41 \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f',msg_saved_success:'\u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c41 \u0c35\u0c3f\u0c1c\u0c2f\u0c35\u0c02\u0c24\u0c02\u0c17\u0c3e \u0c2d\u0c26\u0c4d\u0c30\u0c2a\u0c30\u0c1a\u0c2c\u0c21\u0c4d\u0c21\u0c3e\u0c2f\u0c3f!',msg_update_error:'\u0c28\u0c35\u0c40\u0c15\u0c30\u0c3f\u0c02\u0c1a\u0c21\u0c02 \u0c35\u0c3f\u0c2b\u0c32\u0c2e\u0c48\u0c02\u0c26\u0c3f. \u0c26\u0c2f\u0c1a\u0c47\u0c38\u0c3f \u0c35\u0c3f\u0c35\u0c30\u0c3e\u0c32\u0c28\u0c41 \u0c38\u0c30\u0c3f\u0c1a\u0c42\u0c38\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f.',msg_loading_profile:'\u0c2a\u0c4d\u0c30\u0c4a\u0c2b\u0c48\u0c32\u0c4d \u0c32\u0c4b\u0c21\u0c4d \u0c05\u0c35\u0c41\u0c24\u0c4b\u0c02\u0c26\u0c3f...',msg_empty_tasks:'\u0c2a\u0c4d\u0c30\u0c38\u0c4d\u0c24\u0c41\u0c24\u0c02 \u0c2a\u0c28\u0c41\u0c32\u0c47\u0c35\u0c40 \u0c15\u0c47\u0c1f\u0c3e\u0c2f\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c32\u0c47\u0c26\u0c41.',msg_empty_notifications:'\u0c2a\u0c4d\u0c30\u0c38\u0c4d\u0c24\u0c41\u0c24\u0c02 \u0c28\u0c4b\u0c1f\u0c3f\u0c2b\u0c3f\u0c15\u0c47\u0c37\u0c28\u0c4d\u200c\u0c32\u0c41 \u0c0f\u0c35\u0c40 \u0c32\u0c47\u0c35\u0c41.'},kn:{nav_home:'\u0cae\u0cc1\u0c96\u0caa\u0cc1\u0c9f',nav_tasks:'\u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0c97\u0cb3\u0cc1 (Tasks)',nav_vendors:'\u0cb5\u0ccd\u0caf\u0cbe\u0caa\u0cbe\u0cb0\u0cbf\u0c97\u0cb3\u0cc1',nav_reports:'\u0cb5\u0cb0\u0ca6\u0cbf\u0c97\u0cb3\u0cc1',nav_profile:'\u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd',nav_more:'\u0c87\u0ca8\u0ccd\u0ca8\u0cb7\u0ccd\u0c9f\u0cc1',action_save:'\u0c89\u0cb3\u0cbf\u0cb8\u0cbf',action_cancel:'\u0cb0\u0ca6\u0ccd\u0ca6\u0cc1\u0cae\u0cbe\u0ca1\u0cbf',action_done:'\u0cae\u0cc1\u0c97\u0cbf\u0ca6\u0cbf\u0ca6\u0cc6',action_edit:'\u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cbf',action_edit_profile:'\u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd \u0ca4\u0cbf\u0ca6\u0ccd\u0ca6\u0cbf',action_delete:'\u0c85\u0cb3\u0cbf\u0cb8\u0cbf',action_logout:'\u0cb2\u0cbe\u0c97\u0ccd \u0c94\u0c9f\u0ccd',action_retry:'\u0cae\u0ca4\u0ccd\u0ca4\u0cc6 \u0caa\u0ccd\u0cb0\u0caf\u0ca4\u0ccd\u0ca8\u0cbf\u0cb8\u0cbf',action_back:'\u0cb9\u0cbf\u0c82\u0ca6\u0c95\u0ccd\u0c95\u0cc6',action_confirm:'\u0ca6\u0cc3\u0ca2\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf',action_close:'\u0cae\u0cc1\u0c9a\u0ccd\u0c9a\u0cbf',action_start:'\u0caa\u0ccd\u0cb0\u0cbe\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cbf',action_complete:'\u0caa\u0cc2\u0cb0\u0ccd\u0ca3\u0c97\u0cca\u0cb3\u0cbf\u0cb8\u0cbf',action_accept:'\u0cb8\u0ccd\u0cb5\u0cc0\u0c95\u0cb0\u0cbf\u0cb8\u0cbf',action_reject:'\u0ca4\u0cbf\u0cb0\u0cb8\u0ccd\u0c95\u0cb0\u0cbf\u0cb8\u0cbf',action_saving:'\u0c89\u0cb3\u0cbf\u0cb8\u0cb2\u0cbe\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6...',action_logging_out:'\u0cb2\u0cbe\u0c97\u0ccd \u0c94\u0c9f\u0ccd \u0c86\u0c97\u0cc1\u0ca4\u0ccd\u0ca4\u0cbf\u0ca6\u0cc6...',header_profile:'\u0cb5\u0ccd\u0caf\u0cb5\u0cb8\u0ccd\u0ca5\u0cbe\u0caa\u0c95\u0cb0 \u0caa\u0ccd\u0cb0\u0cca\u0cab\u0cc8\u0cb2\u0ccd',header_settings:'\u0cb8\u0cc6\u0c9f\u0ccd\u0c9f\u0cbf\u0c82\u0c97\u0ccd\u200c\u0c97\u0cb3\u0cc1',header_notifications:'\u0c85\u0ca7\u0cbf\u0cb8\u0cc2\u0c9a\u0ca8\u0cc6\u0c97\u0cb3\u0cc1',header_tasks:'\u0c95\u0cbe\u0cb0\u0ccd\u0caf\u0c97\u0cb3 \u0caa\u0c9f\u0ccd\u0c9f\u0cbf',header_vendors:'\u0cb5\u0ccd\u0caf\u0cbe\u0caa\u0cbe\u0cb0\u0cbf\u0c97\u0cb3 \u0caa\u0c9f\u0ccd\u0c9f\u0cbf',header_reports:'\u0cb5\u0cb0\u0ca6\u0cbf\u0c97\u0cb3\u0cc1',header_dashboard:'\u0ca1\u0ccd\u0caf\u0cbe\u0cb6\u0ccd\u200c\u0cac\u0ccb\u0cb0\u0ccd\u0ca1\u0ccd',section_account_info:'\u0c96\u0cbe\u0ca4\u0cc6 \u0cae\u0cbe\u0cb9\u0cbf\u0ca4\u0cbf',section_work_scope:'\u0c95\u0cbe\u0cb0\u0ccd\u0caf \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0ccd\u0caf\u0cbe\u0caa\u0ccd\u0ca4\u0cbf \u0cb5\u0cbf\u0cb5\u0cb0',section_identity_kyc:'\u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0cb0\u0cbf\u0cb6\u0cc0\u0cb2\u0ca8\u0cc6 (KYC)',section_bank_details:'\u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0c96\u0cbe\u0ca4\u0cc6 \u0cb5\u0cbf\u0cb5\u0cb0\u0c97\u0cb3\u0cc1',section_actions:'\u0ca4\u0ccd\u0cb5\u0cb0\u0cbf\u0ca4 \u0c95\u0ccd\u0cb0\u0cae\u0c97\u0cb3\u0cc1',field_full_name:'\u0caa\u0cc2\u0cb0\u0ccd\u0ca3 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1',field_email:'\u0c85\u0ca7\u0cbf\u0c95\u0cc3\u0ca4 \u0c87\u0cae\u0cc7\u0cb2\u0ccd',field_mobile:'\u0ca8\u0ccb\u0c82\u0ca6\u0cbe\u0caf\u0cbf\u0ca4 \u0cae\u0cca\u0cac\u0cc8\u0cb2\u0ccd',field_dob:'\u0cb9\u0cc1\u0c9f\u0ccd\u0c9f\u0cbf\u0ca6 \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95',field_gender:'\u0cb2\u0cbf\u0c82\u0c97',field_employee_id:'\u0cb5\u0ccd\u0caf\u0cb5\u0cb8\u0ccd\u0ca5\u0cbe\u0caa\u0c95 \u0c90\u0ca1\u0cbf (Employee ID)',field_role:'\u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0ca4 \u0caa\u0cbe\u0ca4\u0ccd\u0cb0',field_role_level:'\u0caa\u0cbe\u0ca4\u0ccd\u0cb0\u0ca6 \u0cb9\u0c82\u0ca4',field_territory:'\u0ca8\u0cbf\u0caf\u0ccb\u0c9c\u0cbf\u0ca4 \u0cb5\u0ccd\u0caf\u0cbe\u0caa\u0ccd\u0ca4\u0cbf',field_supervisor:'\u0ca8\u0cc7\u0cb0 \u0cae\u0cc7\u0cb2\u0ccd\u0cb5\u0cbf\u0c9a\u0cbe\u0cb0\u0c95',field_status:'\u0c96\u0cbe\u0ca4\u0cc6\u0caf \u0cb8\u0ccd\u0ca5\u0cbf\u0ca4\u0cbf',field_active_since:'\u0cb8\u0c95\u0ccd\u0cb0\u0cbf\u0caf \u0ca6\u0cbf\u0ca8\u0cbe\u0c82\u0c95',field_aadhaar:'\u0c86\u0ca7\u0cbe\u0cb0\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6',field_pan:'\u0caa\u0ccd\u0caf\u0cbe\u0ca8\u0ccd \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6',field_residential_address:'\u0cb5\u0cbf\u0cb3\u0cbe\u0cb8',field_account_holder:'\u0c96\u0cbe\u0ca4\u0cc6\u0ca6\u0cbe\u0cb0\u0cb0 \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1',field_bank_name:'\u0cac\u0ccd\u0caf\u0cbe\u0c82\u0c95\u0ccd \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1',field_branch:'\u0cb6\u0cbe\u0c96\u0cc6\u0caf \u0cb9\u0cc6\u0cb8\u0cb0\u0cc1',field_account_number:'\u0c96\u0cbe\u0ca4\u0cc6 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6',field_ifsc:'IFSC \u0c95\u0ccb\u0ca1\u0ccd',field_city:'\u0ca8\u0c97\u0cb0',field_street:'\u0cb0\u0cb8\u0ccd\u0ca4\u0cc6 / \u0cae\u0ca8\u0cc6 \u0cb8\u0c82\u0c96\u0ccd\u0caf\u0cc6',field_pincode:'\u0caa\u0cbf\u0ca8\u0ccd\u200c\u0c95\u0ccb\u0ca1\u0ccd',priority_high:'\u0cb9\u0cc6\u0c9a\u0ccd\u0c9a\u0cbf\u0ca8 \u0c86\u0ca6\u0ccd\u0caf\u0ca4\u0cc6 (HIGH)',priority_medium:'\u0cae\u0ca7\u0ccd\u0caf\u0cae \u0c86\u0ca6\u0ccd\u0caf\u0ca4\u0cc6 (MEDIUM)',priority_low:'\u0c95\u0ca1\u0cbf\u0cae\u0cc6 \u0c86\u0ca6\u0ccd\u0ca