# Backend Specific Configuration (.env.example)
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000/api/v1
SOCKET_URL=http://localhost:3000

# Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=7d
OTP_SALT_SECRET=your_otp_salt_secret_here

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/fic_operations?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://<username>:<password>@fic-cluster.mongodb.net/fic_operations?retryWrites=true&w=majority
DB_NAME=fic_operations

# Cache
REDIS_URL=redis://default:<password>@<host>:6379

# Storage (AWS / Cloudinary)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=fic-operations-cloud-storage

# Push Notifications
FIREBASE_PROJECT_ID=fic-connect-app
FCM_SERVER_KEY=your_fcm_server_key
